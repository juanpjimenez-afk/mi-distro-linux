# Configuración de Infinity OS — edita esto y vuelve a construir la ISO.

# Base: Ubuntu 26.04 LTS ("resolute"). Soporte de seguridad hasta 2031.
SUITE=resolute
MIRROR=http://archive.ubuntu.com/ubuntu

# Nombre del sistema y del usuario del modo "en vivo"
OS_NAME="Infinity OS"
HOSTNAME_LIVE=infinity
LIVE_USER=infinity

# Región (Chile). Otros países: es_ES, es_AR, es_CO, es_MX, es_PE...
LOCALE=es_CL.UTF-8
# Distribución del teclado: latam (Latinoamérica: el teclado chileno estándar), es (España), us (inglés)
KB_LAYOUT=latam
# Zona horaria (lista completa: timedatectl list-timezones). Afecta al reloj del dock.
TIMEZONE=America/Santiago
