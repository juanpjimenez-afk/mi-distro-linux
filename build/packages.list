# Paquetes de Infinity OS (uno por línea; "#" son comentarios).
# Se instalan SIN "recomendados", así que la lista es todo lo que hay en el sistema.
# Menos paquetes = ISO más pequeña, arranque más rápido y menos RAM.

# --- Núcleo y arranque -------------------------------------------------------
linux-image-generic
linux-firmware
intel-microcode
amd64-microcode
initramfs-tools
zstd                        # compresión rápida del initramfs
casper                      # arranque en vivo desde la ISO

# --- Sistema base ------------------------------------------------------------
systemd-sysv
systemd-resolved
systemd-zram-generator      # swap comprimido en RAM
earlyoom                    # evita que el equipo se congele si se llena la RAM
dbus-user-session
dbus-bin
libpam-systemd
polkitd
udisks2
sudo
locales
tzdata
systemd-timesyncd         # hora automática por internet (Ajustes → Fecha y hora; sin él timedatectl dice «NTP not supported»)
kbd
bash-completion
nano
less
curl
ca-certificates

# --- Red ---------------------------------------------------------------------
network-manager
wpasupplicant
wireless-regdb
iw
bluez                      # Bluetooth: servicio y bluetoothctl (el botón de la píldora de estado lo abre; solo sale si hay adaptador)

# --- Audio -------------------------------------------------------------------
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pavucontrol

# --- Gráficos / escritorio ---------------------------------------------------
libgl1-mesa-dri
xwayland
hyprland                    # compositor Wayland: da el desenfoque "cristal"
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
policykit-1-gnome           # agente de polkit: la ventana de contraseña de gdebi (sin él, pkexec falla)
gtklock                     # pantalla de bloqueo: hora gigante de cristal (GTK3, dibuja por CPU)
swaylock                    # bloqueo de respaldo, por si gtklock fallara
hypridle
swaybg
grim
slurp
wl-clipboard
brightnessctl
greetd
tuigreet

# --- Juegos: Vulkan y librerías de 32 bits -----------------------------------
# La arquitectura i386 se habilita en chroot-setup.sh. Steam y muchos juegos y Wine la necesitan.
mesa-vulkan-drivers         # controladores Vulkan de Mesa (64 bits)
mesa-vulkan-drivers:i386    # controladores Vulkan de Mesa (32 bits)
libvulkan1                  # cargador de Vulkan (64 bits)
libvulkan1:i386             # cargador de Vulkan (32 bits)
libgl1-mesa-dri:i386        # OpenGL de 32 bits
libglx-mesa0:i386           # GLX de 32 bits
vulkan-tools                # vulkaninfo: comprobar el driver Vulkan
dxvk                        # DXVK (Direct3D sobre Vulkan) para Wine; lo comprueba infinity-juegos
vulkan-validationlayers     # capas de validación de Vulkan (depurar drivers y juegos)
gamemode                    # daemon de rendimiento (CPU, prioridad) a demanda: gamemoderun
mangohud                    # superposición de FPS y temperaturas (MANGOHUD=1 %command%)
steam-installer             # Steam (multiverse). Trae steam-libs-i386 y zenity/lsof como dependencias
steam-devices               # reglas udev para mandos y periféricos de Steam (multiverse)
python3-tk                  # ventana de Juegos (tkinter estándar, sin dependencias extra)

# --- Shell Infinity (dock, orbe y buscador) ----------------------------------
python3
python3-gi
python3-gi-cairo
python3-cryptography        # gestor de contraseñas (AES-GCM): Contraseñas (infinity-boveda; shell/infinity_shell/boveda.py)
gir1.2-gtk-4.0
gir1.2-gtk4layershell-1.0
libgtk4-layer-shell0
librsvg2-common
# WebKitGTK 6.0 (namespace GI "WebKit", NO "WebKit2": ese es el de GTK3/4.1) para pAnkI (panki_app.py):
# resolute ya lo trae porque lo exige epiphany-browser (gir1.2-webkit-6.0 depende de libwebkitgtk-6.0-4;
# se lista aparte porque epiphany no exige el paquete de introspección, solo la librería).
gir1.2-webkit-6.0
libwebkitgtk-6.0-4
webp-pixbuf-loader         # leer imágenes .webp (Epiphany guarda así): Ajustes → «Añadir imagen…» (GdkPixbuf)
gsettings-desktop-schemas
dconf-gsettings-backend
libglib2.0-bin              # glib-compile-schemas
gtk-update-icon-cache

# --- Aplicaciones ------------------------------------------------------------
foot                        # terminal ligera (con efecto cristal)
thunar                      # archivos
thunar-archive-plugin       # Thunar: "extraer aquí" en .zip y .tar.gz
file-roller                 # extractor del plugin de arriba (no se instala solo: no hay recomendados)
gdebi                       # doble clic en un .deb: lo instala, pide contraseña de administrador
libfuse2t64                 # libfuse.so.2: sin ella no arranca un AppImage
fuse3                       # fusermount: el AppImage monta su imagen con él (ya lo trae xdg-desktop-portal)
xdg-utils                   # xdg-open: el buscador del orbe abre la búsqueda web
gvfs
epiphany-browser            # navegador (GNOME Web)
btop
fastfetch

# --- Apariencia --------------------------------------------------------------
fonts-inter
fonts-jetbrains-mono
fonts-noto-core
fonts-noto-color-emoji
papirus-icon-theme
adwaita-icon-theme
bibata-cursor-theme

# --- Máquinas virtuales (para probar desde Windows) ---------------------------
open-vm-tools               # VMware: portapapeles y resolución automática
qemu-guest-agent
spice-vdagent
