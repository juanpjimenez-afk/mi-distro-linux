#!/bin/sh
# Fondo de pantalla de Infinity OS: la cascada, con menos brillo (ver branding/make_assets.py).
#
# Por defecto se muestra siempre, también dentro de una máquina virtual.
# Aviso: en una VM sin aceleración 3D (VirtualBox) el fondo es una superficie a pantalla completa
# que se dibuja por CPU, y cada movimiento del ratón cuesta más. Si el ratón vuelve a ir con lag:
#   echo color > ~/.config/infinity/fondo     (fondo sólido, sin imagen)
# Para volver a la imagen:
#   echo imagen > ~/.config/infinity/fondo

modo=imagen
[ -r "$HOME/.config/infinity/fondo" ] && modo=$(tr -d ' \n' < "$HOME/.config/infinity/fondo")

case "$modo" in
    color) exit 0 ;;
esac

exec swaybg -i /usr/share/infinity/wallpaper.jpg -m fill
