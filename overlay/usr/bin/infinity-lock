#!/bin/sh
# Bloquea la pantalla con la hora en directo, como en la maqueta de referencia (gtklock).
#
# La hora, su tamaño y su posición se calculan según la resolución de la pantalla donde está el
# foco: las plantillas están en /usr/share/infinity/lock/ (layout.tpl y style.tpl) y el fondo
# en /usr/share/infinity/lock/fondos/. Si gtklock no arranca, se usa swaylock.
#
# OJO: "gtklock -d" devuelve 1 aunque bloquee bien, así que no se fía de su código de salida:
# se lanza en segundo plano y se comprueba que sigue vivo.
#
# Uso: infinity-lock [--arranque]. Con --arranque (lo lanza hyprland.conf al empezar la sesión) solo
# bloquea si greetd abrió la sesión como primer inicio (exporta INFINITY_BLOQUEO_ARRANQUE=1) y el
# bloqueo de este arranque aún no salió. Así, al cerrar sesión y volver a entrar con tuigreet no
# aparece el bloqueo, y si Hyprland se cae y vuelve a arrancar, tampoco sale otra vez.
#
# Esa marca es $XDG_RUNTIME_DIR/infinity-bloqueo-arranque. Esa carpeta es solo tuya y logind la borra
# al cerrar la última sesión del usuario, así que la marca dura lo que la sesión de inicio. No vale
# /tmp: otro usuario podría crear la marca y evitar el bloqueo. Sin XDG_RUNTIME_DIR no hay marca: bloquea.

if [ "${1:-}" = "--arranque" ]; then
    [ -n "${INFINITY_BLOQUEO_ARRANQUE:-}" ] || exit 0
    if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
        [ -e "$XDG_RUNTIME_DIR/infinity-bloqueo-arranque" ] && exit 0
        # La marca se crea al decidir bloquear, no justo antes de gtklock: las salidas de más abajo
        # (gtklock o swaylock ya en marcha, o fallo al crear la caché, que pasa directo a swaylock)
        # también cuentan como el bloqueo de este arranque.
        touch "$XDG_RUNTIME_DIR/infinity-bloqueo-arranque" 2>/dev/null
    fi
fi

pidof gtklock >/dev/null 2>&1 && exit 0
pidof swaylock >/dev/null 2>&1 && exit 0

LIB=/usr/share/infinity/lock
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/infinity/lock"
mkdir -p "$CACHE" 2>/dev/null || exec swaylock

# Tamaño lógico de la pantalla con el foco (1920x1080 si no se puede consultar Hyprland)
TAM=$(hyprctl -j monitors 2>/dev/null | python3 -c '
import json, sys
m = [x for x in json.load(sys.stdin) if x.get("focused")]
x = m[0] if m else {"width": 1920, "height": 1080, "scale": 1}
print(round(x["width"] / x["scale"]), round(x["height"] / x["scale"]))' 2>/dev/null)
[ -n "$TAM" ] || TAM="1920 1080"
set -- $TAM
LW=$1
LH=$2

# La hora va en la esquina superior derecha, a escala de la pantalla (diseñada a 1920x1080).
eval "$(awk -v LH="$LH" 'BEGIN {
    f = LH / 1080
    printf "MT=%d MD=%d MF=%d TH=%d TF=%d\n", 60 * f, 90 * f, 21 * f, 250 * f, 17 * f
}')"
sed -e "s/@MARGEN_SUPERIOR@/$MT/" -e "s/@MARGEN_DERECHO@/$MD/" -e "s/@MARGEN_FECHA@/$MF/" \
    "$LIB/layout.tpl" > "$CACHE/layout.xml"
sed -e "s/@TAMANO_HORA@/$TH/" -e "s/@TAMANO_FECHA@/$TF/" "$LIB/style.tpl" > "$CACHE/style.css"

FONDO="$LIB/fondos/wallpaper-lock-${LW}x${LH}.jpg"
[ -r "$FONDO" ] || FONDO="$LIB/fondos/wallpaper-lock-1920x1080.jpg"

gtklock -b "$FONDO" -x "$CACHE/layout.xml" -s "$CACHE/style.css" >/dev/null 2>&1 &
sleep 2
pidof gtklock >/dev/null 2>&1 && exit 0
exec swaylock
