#!/bin/sh
# pAnkI, el asistente de Infinity OS: tareas, agenda, notas y un chat con reglas en español; en Modo
# Profundo puede consultar algún servicio público gratuito para preguntas generales. Vive en tu
# navegador (WebKitGTK), sin cuenta ni clave. Ventana: shell/infinity_shell/panki_app.py (se instala en
# /usr/lib/infinity); la página: shell/infinity_shell/panki_web/app.html (/usr/share/infinity/panki/app.html).
#
#   infinity-panki                     abre pAnkI
#   infinity-panki --preguntar TEXTO   abre pAnkI (o usa la que ya está abierta) y le envía el texto
#
# Con pAnkI en marcha, la burbuja y el atajo la muestran u ocultan sin lanzar otro proceso:
#   gapplication action org.infinity.Panki alternar || infinity-panki
export PYTHONPATH=/usr/lib/infinity
export GSK_RENDERER="${GSK_RENDERER:-cairo}"
exec python3 -m infinity_shell.panki_app "$@"
