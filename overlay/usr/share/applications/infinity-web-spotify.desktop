[Desktop Entry]
Type=Application
Name=Spotify
Comment=Abre Spotify en su propia ventana
Exec=google-chrome-stable --ozone-platform=wayland --no-first-run --no-default-browser-check --app=https://open.spotify.com/
Icon=/usr/share/infinity/webapps/spotify.svg
Categories=AudioVideo;Audio;Music;Network;
Keywords=musica;podcasts;streaming;
StartupWMClass=chrome-open.spotify.com__-Default
StartupNotify=true
Terminal=false
