[Desktop Entry]
Type=Application
Name=Claude
Comment=Abre Claude en su propia ventana
Exec=google-chrome-stable --ozone-platform=wayland --no-first-run --no-default-browser-check --app=https://claude.ai/
Icon=/usr/share/infinity/webapps/claude.svg
Categories=Utility;Network;
Keywords=ia;asistente;chat;anthropic;
StartupWMClass=chrome-claude.ai__-Default
StartupNotify=true
Terminal=false
