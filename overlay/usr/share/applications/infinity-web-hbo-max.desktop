[Desktop Entry]
Type=Application
Name=HBO Max
Comment=Abre HBO Max en su propia ventana
Exec=google-chrome-stable --app=https://play.hbomax.com/
Icon=/usr/share/infinity/webapps/hbo-max.svg
Categories=AudioVideo;Video;Network;
