[Desktop Entry]
Type=Application
Name=Gemini
Comment=Abre Gemini en su propia ventana
Exec=google-chrome-stable --app=https://gemini.google.com/app
Icon=/usr/share/infinity/webapps/gemini.svg
Categories=Utility;Network;
Keywords=ia;asistente;chat;google;
StartupWMClass=chrome-gemini.google.com__app-Default
StartupNotify=true
Terminal=false
