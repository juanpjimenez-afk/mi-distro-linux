[Desktop Entry]
Type=Application
Name=Netflix
Comment=Abre Netflix en su propia ventana
Exec=google-chrome-stable --app=https://www.netflix.com/browse
Icon=/usr/share/infinity/webapps/netflix.svg
Categories=AudioVideo;Video;Network;
Keywords=series;peliculas;cine;streaming;
StartupWMClass=chrome-www.netflix.com__browse-Default
StartupNotify=true
Terminal=false
