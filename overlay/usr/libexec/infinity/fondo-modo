#!/bin/sh
# Qué tipo de fondo usa Infinity OS: "imagen" (una foto, por defecto) o "color" (sólido, con la marca ∞).
# Lo usan infinity-wallpaper y el shell, así que la decisión está en un solo sitio. QUÉ foto es lo decide
# /usr/libexec/infinity/fondo-ruta.
#
# El usuario lo cambia en Ajustes → Escritorio, que escribe ~/.config/infinity/fondo: "color", "imagen"
# (la cascada) o el id de otro fondo. Para este script, cualquier cosa que no sea "color" es una imagen.
# En una VM sin 3D la cascada va más lenta al mover el ratón (ver el README): ahí se puede elegir "color".
# Respeta XDG_CONFIG_HOME, igual que la app de Ajustes (shell/infinity_shell/ajustes.py).

modo=imagen
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/infinity/fondo"
if [ -r "$cfg" ]; then
    elegido=$(tr -d ' \t\r\n' < "$cfg" | tr 'A-Z' 'a-z')
    [ "$elegido" = color ] && modo=color
fi
echo "$modo"
