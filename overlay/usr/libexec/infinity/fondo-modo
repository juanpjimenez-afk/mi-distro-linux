#!/bin/sh
# Qué fondo usa Infinity OS: "imagen" (la cascada, por defecto) o "color" (sólido, con la marca ∞).
# Lo usan infinity-wallpaper y el shell, así que la decisión está en un solo sitio.
#
# El usuario lo cambia con ~/.config/infinity/fondo ("imagen" o "color"). En una VM sin 3D la
# cascada va más lenta al mover el ratón (ver el README): ahí se puede elegir "color".

modo=imagen
if [ -r "$HOME/.config/infinity/fondo" ]; then
    elegido=$(tr -d ' \t\r\n' < "$HOME/.config/infinity/fondo" | tr 'A-Z' 'a-z')
    [ -n "$elegido" ] && modo=$elegido
fi
echo "$modo"
