#!/bin/sh
# Qué imagen de fondo toca: escritorio (swaybg) o pantalla de bloqueo (gtklock). Imprime una ruta a un
# JPEG que existe, o nada (con código 1) si no hay ninguno: quien lo llama tiene su propio último recurso.
#
#   fondo-ruta escritorio              lee ~/.config/infinity/fondo        (imagen | color | id de fondo)
#   fondo-ruta bloqueo ANCHO ALTO      lee ~/.config/infinity/fondo-bloqueo (id de fondo)
#
# Lo escribe la app de Ajustes. Los fondos son los del catálogo del sistema (/usr/share/infinity/fondos/<id>/)
# y los del usuario (~/.local/share/infinity/fondos/u-<nombre>/). Un id solo se usa si es [a-z0-9-]: no
# puede salirse de esas carpetas. Un id borrado, un fichero ausente, vacío o que no empieza como un JPEG, o
# un ajuste raro, no rompen nada: se pasa al siguiente de la cadena.
#   escritorio: el elegido → la cascada → el fondo antiguo (/usr/share/infinity/wallpaper.jpg)
#   bloqueo:    el elegido (esa resolución, o la más parecida de ese fondo) → islandia → el fondo antiguo
#               del bloqueo (esa resolución o 1920x1080)
# La misma lógica, en Python, está en shell/infinity_shell/fondos.py (una prueba comprueba que coinciden).
#
# INFINITY_SHARE (por defecto /usr/share/infinity) solo se cambia en las pruebas.

export LC_ALL=C
SHARE="${INFINITY_SHARE:-/usr/share/infinity}"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/infinity"
DATOS="${XDG_DATA_HOME:-$HOME/.local/share}/infinity/fondos"

# Id válido: 1-40 caracteres de [a-z0-9-], sin empezar ni acabar en guion.
id_valido() {
    case "$1" in
        '' | *[!a-z0-9-]* | -* | *-) return 1 ;;
    esac
    [ "${#1}" -le 40 ]
}

# Lee el contenido de un fichero de ajuste sin espacios, en minúsculas y recortado.
leer_ajuste() {
    [ -r "$1" ] || return 0
    tr -d ' \t\r\n' <"$1" 2>/dev/null | tr 'A-Z' 'a-z' | head -c 64
}

# Un fichero sirve si no está vacío y empieza como un JPEG (FF D8 FF). $2=1: tampoco puede ser un enlace.
jpeg_ok() {
    [ -f "$1" ] && [ -s "$1" ] && [ -r "$1" ] || return 1
    if [ "${2:-0}" = 1 ] && [ -L "$1" ]; then return 1; fi
    [ "$(head -c 3 "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = ffd8ff ]
}

# Carpeta de un id (sin comprobar el contenido). Los ids de usuario empiezan por "u-": su carpeta no
# puede ser un enlace simbólico (y sus ficheros tampoco, ver jpeg_ok).
carpeta_de() {
    id_valido "$1" || return 1
    case "$1" in
        u-*)
            [ -d "$DATOS/$1" ] && [ ! -L "$DATOS/$1" ] && [ ! -L "$DATOS" ] || return 1
            printf '%s\n' "$DATOS/$1"
            ;;
        *)
            [ -d "$SHARE/fondos/$1" ] || return 1
            printf '%s\n' "$SHARE/fondos/$1"
            ;;
    esac
}

# Imagen del escritorio de un id: <carpeta>/escritorio.jpg
escritorio_de() {
    dir=$(carpeta_de "$1") || return 1
    case "$1" in u-*) est=1 ;; *) est=0 ;; esac
    jpeg_ok "$dir/escritorio.jpg" "$est" && printf '%s\n' "$dir/escritorio.jpg"
}

# Imagen de bloqueo de un id para ANCHO ALTO: la exacta, o la más parecida (proporción y luego área).
bloqueo_de() {
    dir=$(carpeta_de "$1") || return 1
    case "$1" in u-*) est=1 ;; *) est=0 ;; esac
    if jpeg_ok "$dir/bloqueo-$2x$3.jpg" "$est"; then
        printf '%s\n' "$dir/bloqueo-$2x$3.jpg"
        return 0
    fi
    for f in "$dir"/bloqueo-*x*.jpg; do
        [ -e "$f" ] || continue
        r=${f##*/bloqueo-}
        r=${r%.jpg}
        printf '%s %s\n' "${r%x*}" "${r#*x}"
    done | awk -v W="$2" -v H="$3" '
        $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $1 > 0 && $2 > 0 {
            d = log(($1 / $2) / (W / H)); if (d < 0) d = -d
            a = $1 * $2 - W * H; if (a < 0) a = -a
            printf "%.3f %d %d %d %d\n", d, a, -($1 * $2), $1, $2
        }' | sort -n -k1,1 -k2,2 -k3,3 | while read -r _ _ _ w h; do
        if jpeg_ok "$dir/bloqueo-${w}x${h}.jpg" "$est"; then
            printf '%s\n' "$dir/bloqueo-${w}x${h}.jpg"
            break
        fi
    done | { read -r ruta && [ -n "$ruta" ] && printf '%s\n' "$ruta"; }
}

case "${1:-}" in
    escritorio)
        elegido=$(leer_ajuste "$CFG/fondo")
        for id in "$elegido" cascada; do
            case "$id" in imagen | color) continue ;; esac
            ruta=$(escritorio_de "$id") && [ -n "$ruta" ] && { printf '%s\n' "$ruta"; exit 0; }
        done
        jpeg_ok "$SHARE/wallpaper.jpg" && { printf '%s\n' "$SHARE/wallpaper.jpg"; exit 0; }
        exit 1
        ;;
    bloqueo)
        W=$2
        H=$3
        case "$W$H" in
            '' | *[!0-9]*) W=1920; H=1080 ;;
        esac
        [ "$W" -gt 0 ] 2>/dev/null && [ "$H" -gt 0 ] 2>/dev/null || { W=1920; H=1080; }
        elegido=$(leer_ajuste "$CFG/fondo-bloqueo")
        for id in "$elegido" islandia; do
            ruta=$(bloqueo_de "$id" "$W" "$H") && [ -n "$ruta" ] && { printf '%s\n' "$ruta"; exit 0; }
        done
        for medida in "${W}x${H}" 1920x1080; do
            jpeg_ok "$SHARE/lock/fondos/wallpaper-lock-$medida.jpg" &&
                { printf '%s\n' "$SHARE/lock/fondos/wallpaper-lock-$medida.jpg"; exit 0; }
        done
        exit 1
        ;;
    *)
        echo "uso: fondo-ruta escritorio | fondo-ruta bloqueo ANCHO ALTO" >&2
        exit 2
        ;;
esac
