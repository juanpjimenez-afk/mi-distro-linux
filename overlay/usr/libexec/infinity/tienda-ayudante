CATALOGO = "/usr/share/infinity/tienda/catalogo.json"
APT_GET = "/usr/bin/apt-get"
DPKG_QUERY = "/usr/bin/dpkg-query"
GPG = "/usr/bin/gpg"
DIR_RUN = "/run/infinity-tienda"
LIMITE_CLAVE = 256 * 1024
LIMITE_CATALOGO = 512 * 1024
LIMITE_FUENTE = 256 * 1024
MARCA = "# Creado por la Tienda de Infinity (infinity-tienda). La tienda lo borra al quitar la app."
ACCIONES = ("instalar", "quitar", "actualizar")

ENTORNO = {
    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "HOME": "/root",
    "TERM": "dumb",
    "DEBIAN_FRONTEND": "noninteractive",
    "APT_LISTCHANGES_FRONTEND": "none",
    "NEEDRESTART_MODE": "a",
}
OPCIONES_APT = ("-y", "-o", "Dpkg::Options::=--force-confold", "-o", "DPkg::Lock::Timeout=300",
                "-o", "APT::Color=0", "-o", "Dpkg::Use-Pty=0")

# --- las mismas reglas que tienda_catalogo.py, para lo que toca root -------------------------------------------------
RE_ID = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
RE_PAQUETE = re.compile(r"^[a-z0-9][a-z0-9+.-]{1,99}$")
RE_SUITE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
RE_COMPONENTE = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")
RE_ARCH = re.compile(r"^(?:amd64|arm64|i386|armhf)$")
RE_FUENTE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}\.(?:list|sources)$")
RE_CLAVE = re.compile(r"^/(?:etc/apt/keyrings|usr/share/keyrings)/[a-z0-9][a-z0-9._-]{0,63}\.gpg$")
RE_HUELLA = re.compile(r"^[0-9A-F]{40}$")
RE_DOMINIO = re.compile(r"^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,24}$")


class Fallo(Exception):
    """Un error que se le explica al usuario tal cual (en español)."""

    def __init__(self, mensaje, codigo=1):
        super().__init__(mensaje)
        self.mensaje = mensaje
        self.codigo = codigo


# --------------------------------------------------------------------------------------- salida
def _escribir(texto):
    try:
        sys.stdout.write(texto + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, OSError, ValueError):
        pass   # la ventana de la tienda se cerró: se sigue trabajando, que apt no debe quedar a medias


def emitir(clave, texto=""):
    _escribir(f"@@{clave} {texto}".rstrip())


def emitir_log(linea):
    _escribir("  " + linea.replace("\x00", ""))


# --------------------------------------------------------------------------------------- confianza
def _es_de_root_y_cerrado(st):
    return st.st_uid == 0 and not st.st_mode & (stat.S_IWGRP | stat.S_IWOTH)


def comprobar_cadena_de_confianza(ruta):
    """El fichero y TODAS sus carpetas (sin enlaces) son de root y no las puede escribir nadie más."""
    real = os.path.realpath(ruta)
    actual = real
    while True:
        st = os.lstat(actual)
        if stat.S_ISLNK(st.st_mode) or not _es_de_root_y_cerrado(st):
            raise Fallo(f"{actual} no es de root o lo puede modificar otro usuario: no me fío del catálogo.", 4)
        siguiente = os.path.dirname(actual)
        if siguiente == actual:
            return real
        actual = siguiente


def leer_catalogo(ruta=CATALOGO, exigir_root=True):
    """El JSON del catálogo, leído con O_NOFOLLOW y comprobando dueño y permisos. Lanza Fallo(…, 4) si no es fiable."""
    try:
        if exigir_root:
            comprobar_cadena_de_confianza(ruta)
        fd = os.open(ruta, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as e:
        raise Fallo(f"No se pudo abrir el catálogo de la tienda: {e.strerror or e}", 4) from None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or (exigir_root and not _es_de_root_y_cerrado(st)):
            raise Fallo("El catálogo de la tienda no es un fichero normal de root.", 4)
        crudo = b""
        while len(crudo) <= LIMITE_CATALOGO:
            trozo = os.read(fd, 65536)
            if not trozo:
                break
            crudo += trozo
    finally:
        os.close(fd)
    if len(crudo) > LIMITE_CATALOGO:
        raise Fallo("El catálogo de la tienda es demasiado grande.", 4)
    try:
        datos = json.loads(crudo.decode("utf-8"))
    except (UnicodeDecodeError, ValueError, RecursionError):
        raise Fallo("El catálogo de la tienda no es un JSON válido.", 4) from None
    if not isinstance(datos, dict) or datos.get("version") != 1 or not isinstance(datos.get("apps"), list):
        raise Fallo("El catálogo de la tienda tiene un formato que no entiendo.", 4)
    return datos


def _https(valor, campo):
    if not isinstance(valor, str) or not valor or len(valor) > 300 or re.search(r"[\s\x00-\x1f\x7f\\\"'<>`]", valor):
        raise Fallo(f"El catálogo trae un «{campo}» no válido.", 4)
    partes = urlsplit(valor)
    try:
        partes.port
    except ValueError:
        raise Fallo(f"El catálogo trae un «{campo}» con un puerto no válido.", 4) from None
    if partes.scheme != "https" or not partes.hostname or partes.username or partes.password or partes.fragment:
        raise Fallo(f"El catálogo trae un «{campo}» que no es una URL https sencilla.", 4)
    if not RE_DOMINIO.fullmatch(partes.hostname):
        raise Fallo(f"El catálogo trae un «{campo}» con un servidor raro.", 4)
    return valor


def _lista(o, clave, patron, obligatorio=False):
    v = o.get(clave)
    if v is None:
        if obligatorio:
            raise Fallo(f"Al catálogo le falta «{clave}».", 4)
        return []
    if not isinstance(v, list) or len(v) > 8 or (obligatorio and not v) or len(set(map(str, v))) != len(v) \
            or not all(isinstance(x, str) and patron.fullmatch(x) for x in v):
        raise Fallo(f"El catálogo trae un «{clave}» no válido.", 4)
    return list(v)


def entrada_apt(datos, ident):
    """La entrada apt `ident` del catálogo ya leído, validada con reglas estrictas, como dict plano."""
    if not isinstance(ident, str) or not RE_ID.fullmatch(ident) or len(ident) > 40:
        raise Fallo("Identificador de aplicación no válido.", 2)
    coincidencias = [a for a in datos["apps"] if isinstance(a, dict) and a.get("id") == ident]
    if len(coincidencias) != 1:
        raise Fallo(f"«{ident}» no está en el catálogo de la tienda.", 2)
    a = coincidencias[0]
    if a.get("tipo") != "apt":
        raise Fallo(f"«{ident}» no se instala con apt.", 2)
    o = a.get("origen")
    if not isinstance(o, dict):
        raise Fallo("Al catálogo le falta el origen de la app.", 4)
    for clave, patron in (("paquete", RE_PAQUETE), ("suite", RE_SUITE), ("archivo_fuente", RE_FUENTE),
                          ("archivo_clave", RE_CLAVE)):
        if not isinstance(o.get(clave), str) or not patron.fullmatch(o[clave]):
            raise Fallo(f"El catálogo trae un «{clave}» no válido.", 4)
    nombre = a.get("nombre")
    if not isinstance(nombre, str) or not nombre.strip() or len(nombre) > 60 or re.search(r"[\x00-\x1f\x7f]", nombre):
        raise Fallo("El catálogo trae un nombre de app no válido.", 4)
    uri = _https(o.get("uri"), "uri")
    return {
        "id": ident,
        "nombre": nombre.strip(),
        "paquete": o["paquete"],
        "uri": uri if uri.endswith("/") else uri + "/",
        "suite": o["suite"],
        "componentes": _lista(o, "componentes", RE_COMPONENTE, obligatorio=True),
        "arquitecturas": _lista(o, "arquitecturas", RE_ARCH),
        "clave_url": _https(o.get("clave_url"), "clave_url"),
        "archivo_clave": o["archivo_clave"],
        "archivo_fuente": o["archivo_fuente"],
        "huella": _lista(o, "huella", RE_HUELLA),
    }


# --------------------------------------------------------------------------------------- clave GPG
class _SoloHttps(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not newurl.startswith("https://"):
            raise urllib.error.URLError("la clave redirige a una dirección que no es https")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def descargar(url, limite=LIMITE_CLAVE, tiempo=30):
    """Los bytes de `url` (https verificado, con tope de tamaño)."""
    abridor = urllib.request.build_opener(_SoloHttps(), urllib.request.HTTPSHandler(context=ssl.create_default_context()))
    peticion = urllib.request.Request(url, headers={"User-Agent": "infinity-tienda/1"})
    try:
        with abridor.open(peticion, timeout=tiempo) as r:
            datos = r.read(limite + 1)
    except (urllib.error.URLError, OSError, ValueError) as e:
        motivo = getattr(e, "reason", None) or e
        raise Fallo(f"No se pudo descargar la clave del repositorio ({motivo}). ¿Hay conexión a internet?") from None
    if len(datos) > limite:
        raise Fallo("La clave del repositorio es demasiado grande: no la acepto.")
    if not datos:
        raise Fallo("La clave del repositorio llegó vacía.")
    return datos


def correr(argv, entrada=None, tiempo=60):
    """(código, stdout, stderr) de una orden corta, con el entorno mínimo."""
    try:
        r = subprocess.run(argv, input=entrada, capture_output=True, env=ENTORNO, timeout=tiempo, check=False)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, b"", str(e).encode()
    return r.returncode, r.stdout, r.stderr


def procesar_clave(datos, huellas, correr_=correr, dir_run=DIR_RUN):
    """Clave descargada → (keyring binario listo para apt, huellas de sus claves principales).

    Acepta una clave «armadura» (texto -----BEGIN PGP…) o ya binaria; GnuPG la lee con un directorio de trabajo
    propio y temporal. Con `huellas` (las del catálogo), TODAS las claves principales del fichero deben estar en la lista.
    """
    os.makedirs(dir_run, mode=0o700, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="gpg-", dir=dir_run) as casa:
        os.chmod(casa, 0o700)
        base = [GPG, "--batch", "--no-tty", "--homedir", casa]
        if datos.lstrip().startswith(b"-----BEGIN PGP PUBLIC KEY BLOCK-----"):
            rc, binario, _err = correr_(base + ["--dearmor"], datos)
            if rc != 0 or not binario:
                raise Fallo("La clave descargada no es una clave GPG pública válida.")
        else:
            binario = datos
        rc, salida, _err = correr_(base + ["--show-keys", "--with-colons", "--fingerprint"], binario)
        if rc != 0:
            raise Fallo("La clave descargada no es una clave GPG pública válida.")
    principales, tipo = [], ""
    for linea in salida.decode("utf-8", "replace").splitlines():
        campos = linea.split(":")
        if campos[0] in ("pub", "sub", "sec", "ssb"):
            tipo = campos[0]
        elif campos[0] == "fpr" and len(campos) > 9 and tipo == "pub":
            principales.append(campos[9].upper())
        if campos[0] in ("sec", "ssb"):
            raise Fallo("El fichero descargado lleva una clave SECRETA, no una pública: lo rechazo.")
    if not principales:
        raise Fallo("La clave descargada no contiene ninguna clave pública.")
    if huellas and not set(principales) <= set(huellas):
        raise Fallo("La huella de la clave descargada no coincide con la que fija el catálogo: no la instalo.")
    return binario, principales


# --------------------------------------------------------------------------------------- ficheros de apt
def escribir_atomico(ruta, datos, modo=0o644):
    """Escribe `datos` (bytes) en `ruta` sin dejar nunca un fichero a medias. Crea la carpeta si falta."""
    carpeta = os.path.dirname(ruta)
    os.makedirs(carpeta, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".tienda-", suffix=".tmp", dir=carpeta)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(datos)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, modo)
        os.replace(tmp, ruta)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def texto_fuente(o):
    """El contenido del fichero de fuente de apt: una línea `deb [...]` (.list) o deb822 (.sources)."""
    if o["archivo_fuente"].endswith(".list"):
        opciones = []
        if o["arquitecturas"]:
            opciones.append("arch=" + ",".join(o["arquitecturas"]))
        opciones.append("signed-by=" + o["archivo_clave"])
        return f"{MARCA}\ndeb [{' '.join(opciones)}] {o['uri']} {o['suite']} {' '.join(o['componentes'])}\n"
    lineas = [MARCA, "Types: deb", f"URIs: {o['uri']}", f"Suites: {o['suite']}",
              f"Components: {' '.join(o['componentes'])}"]
    if o["arquitecturas"]:
        lineas.append("Architectures: " + " ".join(o["arquitecturas"]))
    lineas.append(f"Signed-By: {o['archivo_clave']}")
    return "\n".join(lineas) + "\n"


def _leer_texto(ruta):
    try:
        with open(ruta, "rb") as f:
            return f.read(LIMITE_FUENTE).decode("utf-8", "replace")
    except OSError:
        return None


def explicar_error_apt(lineas):
    """Un mensaje claro a partir de las últimas líneas que imprimió apt al fallar."""
    texto = "\n".join(lineas)
    reglas = (
        (r"Could not get lock|Unable to acquire the dpkg frontend lock",
         "Otro programa está usando apt (¿otra instalación en curso?). Inténtalo de nuevo en un minuto."),
        (r"\b404\b|Not Found|\b403\b|Forbidden|does not have a Release file",
         "El servidor del repositorio dice que esa dirección no existe o no está permitida (404/403): puede que el "
         "fabricante la haya cambiado o retirado."),
        (r"Could not resolve|Temporary failure resolving|Failed to fetch|Connection failed|Network is unreachable"
         r"|Unable to connect|Could not connect",
         "No hay conexión con el servidor de paquetes. Comprueba tu conexión a internet y vuelve a intentarlo."),
        (r"No space left on device",
         "No queda espacio en disco. En modo en vivo sin guardado el espacio es la RAM: libera memoria o arranca con "
         "«Guardar cambios»."),
        (r"dpkg was interrupted|dpkg --configure -a",
         "dpkg quedó a medias de una instalación anterior. Abre una terminal y ejecuta: sudo dpkg --configure -a"),
        (r"Unable to locate package|has no installation candidate",
         "apt no encuentra el paquete (¿fallaron las listas del repositorio?)."),
        (r"unmet dependencies|held broken packages|Depends:",
         "Hay dependencias que no se pueden satisfacer con los repositorios de este sistema."),
        (r"NO_PUBKEY|not signed|signature|The following signatures",
         "apt no pudo verificar la firma del repositorio (la clave GPG no coincide)."),
    )
    for patron, mensaje in reglas:
        if re.search(patron, texto, re.I):
            return mensaje
    return "apt terminó con un error. El registro de la instalación tiene el detalle."


# --------------------------------------------------------------------------------------- apt
def parsear_estado(linea):
    """«dlstatus:1:12.5:texto» / «pmstatus:pkg:45.0:texto» (APT::Status-Fd) → (tipo, porcentaje 0-100, texto) o None."""
    # El nombre del paquete puede llevar «:» (libc6:i386): el porcentaje es el primer campo numérico entre dos «:».
    m = re.match(r"^(dlstatus|pmstatus|pmerror):(.*?):([0-9]+(?:\.[0-9]+)?):(.*)$", linea)
    if m is None:
        return None
    return m.group(1), max(0.0, min(100.0, float(m.group(3)))), m.group(4).strip()


def _trocear(buf, datos, al_linea, final=False):
    buf.extend(datos)
    while True:
        m = re.search(rb"[\r\n]", buf)
        if m is None:
            if len(buf) > 65536 or (final and buf):
                al_linea(bytes(buf).decode("utf-8", "replace"))
                buf.clear()
            return
        linea = bytes(buf[:m.start()])
        del buf[:m.end()]
        if linea:
            al_linea(linea.decode("utf-8", "replace"))


def correr_apt(argumentos, al_estado, al_linea, popen=subprocess.Popen):
    """apt-get con APT::Status-Fd: reenvía el registro y los avances. Devuelve el código de salida."""
    leer_estado, escribir_estado = os.pipe()
    try:
        orden = [APT_GET, *OPCIONES_APT, "-o", f"APT::Status-Fd={escribir_estado}", *argumentos]
        try:
            proceso = popen(orden, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            env=ENTORNO, pass_fds=(escribir_estado,), close_fds=True, start_new_session=True, bufsize=0)
        finally:
            os.close(escribir_estado)
        selector = selectors.DefaultSelector()
        try:
            selector.register(proceso.stdout, selectors.EVENT_READ, "log")
            selector.register(leer_estado, selectors.EVENT_READ, "estado")
            buffers = {"log": bytearray(), "estado": bytearray()}
            manejadores = {"log": al_linea, "estado": al_estado}
            abiertos = 2
            while abiertos:
                for clave, _ in selector.select():
                    fd = clave.fileobj if isinstance(clave.fileobj, int) else clave.fileobj.fileno()
                    try:
                        datos = os.read(fd, 65536)
                    except OSError:
                        datos = b""
                    _trocear(buffers[clave.data], datos, manejadores[clave.data], final=not datos)
                    if not datos:
                        selector.unregister(clave.fileobj)
                        abiertos -= 1
            return proceso.wait()
        finally:
            selector.close()
            proceso.stdout.close()
    finally:
        with contextlib.suppress(OSError):
            os.close(leer_estado)


# --------------------------------------------------------------------------------------- el trabajo
class Ayudante:
    """Las tres acciones. Todo lo que toca el sistema se puede sustituir (raíz de ficheros, apt, red, órdenes) para
    probarlo sin ser root; la entrada real de pkexec (main) nunca pasa nada de eso."""

    def __init__(self, datos, raiz="/", correr_=correr, correr_apt_=correr_apt, descargar_=descargar):
        self.datos = datos
        self.raiz = raiz
        self.correr = correr_
        self.correr_apt = correr_apt_
        self.descargar = descargar_
        self.ultimas = deque(maxlen=40)   # lo último que imprimió apt, para explicar un fallo
        self._rango = (0, 100)

    # -- utilidades
    def ruta(self, absoluta):
        return os.path.join(self.raiz, absoluta.lstrip("/"))

    def ruta_fuente(self, o):
        return self.ruta("/etc/apt/sources.list.d/" + o["archivo_fuente"])

    def progreso(self, pct, texto):
        desde, hasta = self._rango
        emitir("PROGRESO", f"{int(desde + (hasta - desde) * pct / 100)} {texto}")

    def _al_linea(self, linea):
        self.ultimas.append(linea)
        emitir_log(linea)

    def _estado_apt(self, texto_dl, texto_pm, rangos):
        """Convierte las líneas de APT::Status-Fd en avances dentro de `rangos` = {tipo: (desde, hasta)}."""
        def al_estado(linea):
            r = parsear_estado(linea)
            if r is None:
                return
            tipo, pct, mensaje = r
            if tipo == "pmerror":
                emitir_log(f"error: {mensaje}")
                return
            desde, hasta = rangos[tipo]
            texto = texto_dl if tipo == "dlstatus" else texto_pm
            emitir("PROGRESO", f"{int(desde + (hasta - desde) * pct / 100)} {texto}")
        return al_estado

    def _apt(self, argumentos, al_estado):
        self.ultimas.clear()
        try:
            codigo = self.correr_apt(argumentos, al_estado, self._al_linea)
        except OSError as e:
            raise Fallo(f"No se pudo ejecutar apt-get: {e.strerror or e}.") from None
        if codigo != 0:
            raise Fallo(explicar_error_apt(list(self.ultimas)))

    def referencias(self, aguja, excepto=None):
        """Ficheros de apt (sin contar líneas comentadas) que mencionan `aguja` (una URI o la ruta de una clave)."""
        archivos = [self.ruta("/etc/apt/sources.list")] + sorted(glob.glob(self.ruta("/etc/apt/sources.list.d/*")))
        hallados = []
        for a in archivos:
            if excepto is not None and os.path.abspath(a) == os.path.abspath(excepto):
                continue
            texto = _leer_texto(a)
            if texto and any(aguja in l and not l.lstrip().startswith("#") for l in texto.splitlines()):
                hallados.append(a)
        return hallados

    def instalado(self, paquete):
        rc, salida, _ = self.correr([DPKG_QUERY, "-W", "--showformat=${db:Status-Abbrev}", paquete])
        return rc == 0 and salida.decode("utf-8", "replace").startswith("ii")

    def archivos_desktop(self, paquete):
        rc, salida, _ = self.correr([DPKG_QUERY, "-L", paquete])
        if rc != 0:
            return []
        encontrados = []
        for l in salida.decode("utf-8", "replace").splitlines():
            m = re.fullmatch(r"/usr/share/applications/([A-Za-z0-9][A-Za-z0-9._+-]*\.desktop)", l)
            if m:
                encontrados.append(m.group(1))
        return encontrados

    # -- el repositorio
    def registrar_repositorio(self, o):
        """Clave + fuente de apt. No toca nada si el repositorio ya lo configuró otro fichero (p. ej. el paquete del
        propio fabricante): una segunda entrada con otra clave haría fallar `apt update`."""
        ruta_fuente = self.ruta_fuente(o)
        otros = self.referencias(o["uri"].rstrip("/"), excepto=ruta_fuente)
        if otros:
            emitir_log(f"El repositorio ya estaba configurado en {os.path.basename(otros[0])}; lo dejo como está.")
            return False
        existente = _leer_texto(ruta_fuente)
        if existente is not None and MARCA not in existente:
            emitir_log(f"{o['archivo_fuente']} ya existe y no es de la tienda; lo dejo como está.")
            return False
        self.progreso(2, f"Descargando la clave de confianza de {o['nombre']}…")
        llave, huellas = procesar_clave(self.descargar(o["clave_url"]), o["huella"], self.correr,
                                        dir_run=self.ruta(DIR_RUN))
        emitir_log("Clave GPG recibida: " + ", ".join(huellas))
        self.progreso(8, "Registrando el repositorio…")
        escribir_atomico(self.ruta(o["archivo_clave"]), llave, 0o644)
        escribir_atomico(ruta_fuente, texto_fuente(o).encode("utf-8"), 0o644)
        return True

    # -- acciones
    def instalar(self, ident):
        o = self._origen(ident)
        self._rango = (0, 100)
        nuevo = not os.path.exists(self.ruta_fuente(o))
        self.registrar_repositorio(o)
        self.progreso(12, "Actualizando las listas de paquetes (la primera vez tarda)…")
        try:
            self._apt(["update"], self._estado_apt("Descargando las listas de paquetes…", "",
                                                   {"dlstatus": (12, 45), "pmstatus": (12, 45)}))
        except Fallo:
            if nuevo:     # un repositorio recién añadido que rompe «apt update» dejaría roto apt para todo el sistema
                emitir_log("Quito el repositorio que acabo de añadir, porque apt no pudo leerlo.")
                self._limpiar_repositorio(o)
            raise
        self.progreso(46, f"Instalando {o['nombre']}…")
        self._apt(["install", o["paquete"]],
                  self._estado_apt(f"Descargando {o['nombre']}…", f"Instalando {o['nombre']}…",
                                   {"dlstatus": (46, 62), "pmstatus": (62, 96)}))
        if not self.instalado(o["paquete"]):
            raise Fallo(f"apt terminó sin errores, pero {o['paquete']} no quedó instalado.")
        for d in self.archivos_desktop(o["paquete"]):
            emitir("ARCHIVO", d)
        self.progreso(100, "Listo.")

    def actualizar(self, ident):
        o = self._origen(ident)
        self.registrar_repositorio(o)
        self.progreso(8, "Actualizando las listas de paquetes…")
        self._apt(["update"], self._estado_apt("Descargando las listas de paquetes…", "", {"dlstatus": (8, 40),
                                                                                       "pmstatus": (8, 40)}))
        self.progreso(41, f"Actualizando {o['nombre']}…")
        self._apt(["install", "--only-upgrade", o["paquete"]],
                  self._estado_apt(f"Descargando {o['nombre']}…", f"Actualizando {o['nombre']}…",
                                   {"dlstatus": (41, 62), "pmstatus": (62, 96)}))
        self.progreso(100, "Listo.")

    def quitar(self, ident):
        o = self._origen(ident)
        self.progreso(5, f"Quitando {o['nombre']}…")
        if self.instalado(o["paquete"]):
            self._apt(["remove", o["paquete"]],
                      self._estado_apt("", f"Quitando {o['nombre']}…", {"dlstatus": (5, 10), "pmstatus": (10, 90)}))
        if self.instalado(o["paquete"]):
            raise Fallo(f"No se pudo quitar {o['paquete']}.")
        self._limpiar_repositorio(o)
        self.progreso(100, "Listo.")

    def _limpiar_repositorio(self, o):
        """Borra la fuente y la clave que puso la tienda, solo si son suyas (llevan la marca) y nadie más usa esa clave."""
        ruta_fuente = self.ruta_fuente(o)
        texto = _leer_texto(ruta_fuente)
        if texto is None or MARCA not in texto:
            return
        with contextlib.suppress(OSError):
            os.unlink(ruta_fuente)
        clave = self.ruta(o["archivo_clave"])
        if not self.referencias(o["archivo_clave"]):
            with contextlib.suppress(OSError):
                os.unlink(clave)

    def _origen(self, ident):
        return entrada_apt(self.datos, ident)


# --------------------------------------------------------------------------------------- entrada
@contextlib.contextmanager
def cerrojo(dir_run=DIR_RUN):
    """Una sola instalación a la vez."""
    os.makedirs(dir_run, mode=0o700, exist_ok=True)
    fd = os.open(os.path.join(dir_run, "tienda.lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise Fallo("Ya hay otra instalación de la tienda en curso.", 3) from None
        yield
    finally:
        os.close(fd)


def main(argv=None):
    argv = sys.argv[1:] if argv is None else list(argv)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    try:
        if len(argv) != 2 or argv[0] not in ACCIONES or not RE_ID.fullmatch(argv[1]) or len(argv[1]) > 40:
            raise Fallo("Uso: tienda-ayudante instalar|quitar|actualizar <id>", 2)
        if os.geteuid() != 0:
            raise Fallo("Este ayudante solo funciona como root (lo lanza la tienda con pkexec).", 2)
        os.umask(0o022)
        with cerrojo():
            ayudante = Ayudante(leer_catalogo())
            getattr(ayudante, argv[0])(argv[1])
    except Fallo as e:
        emitir("ERROR", e.mensaje)
        return e.codigo
    except KeyboardInterrupt:
        emitir("ERROR", "Interrumpido.")
        return 1
    except Exception as e:   # noqa: BLE001 - nunca un traceback pelado a la ventana
        emitir("ERROR", f"Error interno del ayudante: {type(e).__name__}: {e}")
        return 1
    emitir("LISTO")
    return 0


if __name__ == "__main__":
    sys.exit(main())
